---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Home' },
  { href: '/oem', label: 'OEM / Private Label' },
  { href: '/wholesale', label: 'Wholesale' },
  { href: '/contact', label: 'Contact' },
];

function isActive(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-slate-900">
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-brand-600 text-sm font-bold text-white">CL</span>
      <span class="hidden sm:inline">Clearion Labs</span>
    </a>
    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
            isActive(l.href) ? 'bg-brand-50 text-brand-800' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900',
          ]}
        >
          {l.label}
        </a>
      ))}
    </nav>
    <a
      href="/contact#inquiry-form"
      class="rounded-lg bg-brand-600 px-3.5 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700"
    >
      Request Quote
    </a>
  </div>
  <nav class="flex gap-1 overflow-x-auto border-t border-slate-100 px-2 py-1 md:hidden" aria-label="Mobile">
    {links.map((l) => (
      <a
        href={l.href}
        class:list={[
          'whitespace-nowrap rounded-md px-3 py-1.5 text-xs font-medium',
          isActive(l.href) ? 'bg-brand-50 text-brand-800' : 'text-slate-600',
        ]}
      >
        {l.label}
      </a>
    ))}
  </nav>
</header>
