---
import PageLayout from '../layouts/PageLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import FAQ from '../components/FAQ.astro';
import InquiryForm from '../components/InquiryForm.astro';

const faqItems = [
  {
    title: 'Who is wholesale for?',
    description:
      'Salon groups, spas, retailers, e-commerce sellers, and distributors who need repeatable HOCl spray supply without a full private-label project — though private label can be added later.',
  },
  {
    title: 'How do I get a price list?',
    description:
      'Submit the <a href="#inquiry-form" class="text-link">wholesale inquiry</a> with destination country and estimated monthly volume. We share MOQ tiers and sample options.',
  },
  {
    title: 'What is a typical MOQ?',
    description:
      'MOQ depends on SKU and packaging. Sample packs are available first; bulk tiers scale with carton quantities. Include your target in the form for an accurate reply.',
  },
  {
    title: 'Can wholesale accounts move to private label later?',
    description:
      'Yes. Many partners start wholesale, then migrate packaging to branded OEM once demand is proven. See <a href="/oem" class="text-link">OEM / Private Label</a>.',
  },
];
---

<PageLayout
  title="Wholesale HOCl Spray | Bulk Private Label Skincare Supply"
  description="Wholesale HOCl spray and bulk cosmetics-grade hypochlorous acid facial mist for salons, retailers, and distributors. Open account, price list, and MOQ inquiry."
>
  <section class="bg-gradient-to-b from-slate-50 to-white py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-wide text-brand-700">Wholesale</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Bulk HOCl spray for commercial buyers
        </h1>
        <p class="mt-5 text-lg text-slate-600 leading-relaxed">
          Open a wholesale conversation for cosmetics-grade hypochlorous acid facial sprays —
          price list by volume tier, MOQ clarity, and replenishment-friendly supply.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#inquiry-form" class="rounded-lg bg-brand-600 px-5 py-3 text-sm font-semibold text-white hover:bg-brand-700">Request Price List</a>
          <a href="/oem" class="rounded-lg border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-800 hover:bg-slate-50">Need private label?</a>
        </div>
      </div>
    </div>
  </section>

  <TrustBar />

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">Wholesale program highlights</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {[
          { t: 'Price list / volume tiers', d: 'Share monthly volume and destination for tiered FOB or landed guidance.' },
          { t: 'Open account path', d: 'Sample approval → first PO → repeat replenishment for qualified buyers.' },
          { t: 'MOQ transparency', d: 'Carton-based MOQs by SKU; sample packs available before commitment.' },
        ].map((c) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="font-semibold text-slate-900">{c.t}</h3>
            <p class="mt-2 text-sm text-slate-600">{c.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-brand-900 py-14 text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid gap-8 lg:grid-cols-2 lg:items-center">
        <div>
          <h2 class="text-2xl font-bold sm:text-3xl">Built for salon &amp; retail channels</h2>
          <p class="mt-3 text-brand-100 leading-relaxed">
            Position HOCl spray as a daily facial cleansing mist / skin care spray — clean cosmetics language for US-facing wholesale, without disease or drug claims.
          </p>
        </div>
        <ul class="space-y-3 text-sm text-brand-50">
          <li class="flex gap-2"><span>✓</span> Salon back-bar &amp; take-home formats</li>
          <li class="flex gap-2"><span>✓</span> Retail-ready outer packaging options</li>
          <li class="flex gap-2"><span>✓</span> Distributor multi-carton shipping</li>
          <li class="flex gap-2"><span>✓</span> Optional path to branded OEM later</li>
        </ul>
      </div>
    </div>
  </section>

  <FAQ title="Wholesale FAQ" items={faqItems} />
  <InquiryForm title="Wholesale / open account inquiry" defaultBuyerType="Wholesale" />
</PageLayout>
