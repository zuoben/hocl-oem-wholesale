---
import PageLayout from '../layouts/PageLayout.astro';
import FAQ from '../components/FAQ.astro';
import { localizePath, type Locale } from '../i18n/locales';
import { getHome, getOem, getWholesale, withLinks } from '../i18n/pages';
import { buildFaqPageSchema, buildOrganizationSchema } from '../utils/organization-schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const home = getHome(locale);
const oem = getOem(locale);
const wholesale = getWholesale(locale);
const links = {
  oem: localizePath('/oem', locale),
  wholesale: localizePath('/wholesale', locale),
  rfq: `${localizePath('/contact', locale)}#inquiry-form`,
};

const mapItems = (items: { title: string; description: string }[]) =>
  items.map((item) => ({
    title: item.title,
    description: withLinks(item.description, links),
  }));

const overviewFaqs = mapItems(home.faqItems);
const oemFaqs = mapItems(oem.faqItems);
const wholesaleFaqs = mapItems(wholesale.faqItems);
const allFaqs = [...overviewFaqs, ...oemFaqs, ...wholesaleFaqs];

const title = 'HOCl OEM & Wholesale FAQ | Clearion Labs';
const description =
  'FAQ for Clearion Labs B2B buyers: HOCl spray OEM / private label, wholesale MOQ, samples, and cosmetics-safe claims.';

const faqSchema = buildFaqPageSchema(allFaqs);
const orgSchema = buildOrganizationSchema();
---

<PageLayout title={title} description={description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="bg-gradient-to-b from-brand-50 via-white to-white py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-700">FAQ</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-slate-900">HOCl OEM & wholesale FAQ</h1>
      <p class="mt-4 text-lg leading-relaxed text-slate-600">
        Answers for brand builders, salons, retailers, and distributors evaluating Clearion Labs.
      </p>
      <a
        href={links.rfq}
        class="mt-8 inline-flex rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700"
      >
        Request Quote
      </a>
    </div>
  </section>

  <FAQ tagline="Overview" title={home.faqTitle} items={overviewFaqs} />
  <FAQ tagline="OEM" title={oem.faqTitle} items={oemFaqs} />
  <FAQ tagline="Wholesale" title={wholesale.faqTitle} items={wholesaleFaqs} />

  <section class="pb-16">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <p class="text-sm text-slate-600">Still need a formal quote?</p>
      <a href={links.rfq} class="mt-3 inline-flex text-sm font-semibold text-brand-700 hover:underline">Go to inquiry form →</a>
    </div>
  </section>
</PageLayout>
