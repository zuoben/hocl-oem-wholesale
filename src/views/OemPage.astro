---
import PageLayout from '../layouts/PageLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import FAQ from '../components/FAQ.astro';
import InquiryForm from '../components/InquiryForm.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { localizePath, type Locale } from '../i18n/locales';
import { getOem, withLinks } from '../i18n/pages';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getOem(locale);
const links = {
  oem: localizePath('/oem', locale),
  wholesale: localizePath('/wholesale', locale),
  rfq: `${localizePath('/contact', locale)}#inquiry-form`,
};
const faqItems = c.faqItems.map((item) => ({
  title: item.title,
  description: withLinks(item.description, links),
}));
---
<PageLayout title={c.title} description={c.description} locale={locale}>
  <section class="bg-gradient-to-b from-brand-50 to-white py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-wide text-brand-700">{c.kicker}</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">{c.h1}</h1>
        <p class="mt-5 text-lg text-slate-600 leading-relaxed">{c.lead}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#inquiry-form" class="rounded-lg bg-brand-600 px-5 py-3 text-sm font-semibold text-white hover:bg-brand-700">{c.ctaQuote}</a>
          <a href={links.wholesale} class="rounded-lg border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-800 hover:bg-slate-50">{c.ctaWholesale}</a>
        </div>
      </div>
    </div>
  </section>
  <TrustBar locale={locale} />
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">{c.specifyTitle}</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {c.cards.map((card) => (
          <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <h3 class="font-semibold text-slate-900">{card.t}</h3>
            <p class="mt-2 text-sm text-slate-600">{card.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">{c.processTitle}</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {c.steps.map((s) => (
          <div class="rounded-xl bg-white p-5 shadow-sm border border-slate-200">
            <p class="text-xs font-bold tracking-widest text-brand-600">{s.n}</p>
            <h3 class="mt-2 font-semibold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <ProductGrid locale={locale} title={c.productsTitle} tagline={c.productsTagline} intro={c.productsIntro} compact={true} showCta={true} />
  <FAQ title={c.faqTitle} items={faqItems} />
  <InquiryForm locale={locale} title={c.formTitle} defaultBuyerType="OEM / Private Label" />
</PageLayout>
