---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLocaleFromPath, type Locale } from '../i18n/locales';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
}

const { title, description, locale: localeProp } = Astro.props;
const locale = localeProp ?? getLocaleFromPath(Astro.url.pathname);
---

<BaseLayout title={title} description={description} locale={locale}>
  <Header slot="header" locale={locale} />
  <slot />
  <Footer slot="footer" locale={locale} />
</BaseLayout>
