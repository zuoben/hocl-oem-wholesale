---
import PageLayout from '../layouts/PageLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import FAQ from '../components/FAQ.astro';
import InquiryForm from '../components/InquiryForm.astro';

const faqItems = [
  {
    title: 'What is your hero product?',
    description:
      'Hypochlorous acid (<strong>HOCl</strong>) facial spray for cosmetics / personal care use — daily skin cleansing mist and salon-friendly spray formats. Side SKUs (e.g. PDRN serums) can be discussed separately.',
  },
  {
    title: 'Do you support private label and wholesale?',
    description:
      'Yes. Choose <a href="/oem" class="text-link">OEM / Private Label</a> for branded packaging and formulation specs, or <a href="/wholesale" class="text-link">Wholesale</a> for bulk supply to salons, retailers, and distributors.',
  },
  {
    title: 'Can I get samples before a production run?',
    description:
      'Sample-first is our recommended path. Share concentration, bottle size, and destination on the <a href="/contact#inquiry-form" class="text-link">inquiry form</a>.',
  },
  {
    title: 'Are these products drugs or medical devices?',
    description:
      'No. Clearion Labs positions HOCl sprays as <strong>cosmetics / personal care</strong>. We do not make disease treatment claims and do not use FDA-cleared drug/device wording for these products.',
  },
];
---

<PageLayout
  title="Private Label Skincare & HOCl Manufacturer | OEM & Wholesale"
  description="Clearion Labs — private label skincare and HOCl manufacturer for cosmetics-grade hypochlorous acid spray. OEM / private label and wholesale for salons, retailers, and distributors. Sample-first."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-50 via-white to-white">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-brand-100/80 via-transparent to-transparent"></div>
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:py-28">
      <div class="mx-auto max-w-3xl text-center">
        <p class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white/80 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-800 shadow-sm">
          B2B · Cosmetics OEM · US market focus
        </p>
        <h1 class="mt-6 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-[3.25rem] lg:leading-tight">
          HOCl spray OEM &amp; wholesale<br />
          <span class="text-brand-700">for salons, retail &amp; distributors</span>
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">
          Clearion Labs is a private label skincare and HOCl manufacturer partner for cosmetics-grade hypochlorous acid facial sprays —
          private-label packaging, concentration &amp; fill options, and export-ready wholesale.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href="/oem"
            class="inline-flex w-full items-center justify-center rounded-lg bg-brand-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700 sm:w-auto"
          >
            OEM / Private Label
          </a>
          <a
            href="/wholesale"
            class="inline-flex w-full items-center justify-center rounded-lg border border-slate-300 bg-white px-6 py-3.5 text-sm font-semibold text-slate-800 shadow-sm transition hover:bg-slate-50 sm:w-auto"
          >
            Wholesale
          </a>
        </div>
        <p class="mt-4 text-sm text-slate-500">
          Or <a href="/contact#inquiry-form" class="text-link">send a structured RFQ</a> — quote typically within ~24 hours.
        </p>
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- Dual funnel cards -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-brand-700">Two ways to buy</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">Pick the program that fits</h2>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        <a href="/oem" class="group rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition hover:border-brand-300 hover:shadow-md">
          <span class="inline-flex rounded-lg bg-brand-100 px-2.5 py-1 text-xs font-semibold text-brand-800">OEM</span>
          <h3 class="mt-4 text-xl font-bold text-slate-900 group-hover:text-brand-800">Private Label / OEM</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Your brand on bottle &amp; carton. Discuss concentration, pH specs, fill volume, spray actuator, and sampling before mass production.
          </p>
          <span class="mt-6 inline-flex text-sm font-semibold text-brand-700">Explore OEM →</span>
        </a>
        <a href="/wholesale" class="group rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition hover:border-brand-300 hover:shadow-md">
          <span class="inline-flex rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700">Wholesale</span>
          <h3 class="mt-4 text-xl font-bold text-slate-900 group-hover:text-brand-800">Wholesale / Open Account</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Bulk HOCl spray for salon chains, retailers, and distributors. Price lists, MOQ tiers, and replenishment-friendly supply.
          </p>
          <span class="mt-6 inline-flex text-sm font-semibold text-brand-700">Explore wholesale →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Product focus -->
  <section class="bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide text-brand-700">Hero SKU</p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">Hypochlorous acid (HOCl) spray</h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Positioned as a daily facial cleansing mist / skin care spray for cosmetics channels —
            not as a drug or wound-care device. Specs (e.g. concentration range, pH) disclosed as product parameters for B2B buyers.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-slate-700">
            <li class="flex gap-2"><span class="text-brand-600">●</span> Spray mist formats suited to salon &amp; retail shelves</li>
            <li class="flex gap-2"><span class="text-brand-600">●</span> Private-label artwork &amp; packaging options</li>
            <li class="flex gap-2"><span class="text-brand-600">●</span> Side SKUs (PDRN etc.) available to discuss — HOCl remains the lead</li>
          </ul>
        </div>
        <div class="rounded-2xl border border-brand-200 bg-gradient-to-br from-brand-600 to-brand-800 p-8 text-white shadow-lg">
          <p class="text-sm font-medium text-brand-100">Typical inquiry includes</p>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed">
            <li>✓ Target market (US retail / salon / DTC brand)</li>
            <li>✓ Bottle size &amp; estimated monthly volume</li>
            <li>✓ Private label vs white-label wholesale</li>
            <li>✓ Sample request before bulk PO</li>
          </ul>
          <a href="/contact#inquiry-form" class="mt-8 inline-flex rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-brand-800 hover:bg-brand-50">
            Start RFQ
          </a>
        </div>
      </div>
    </div>
  </section>

  <FAQ title="Common questions" items={faqItems} />

  <InquiryForm title="Get a factory-style quote" />
</PageLayout>
