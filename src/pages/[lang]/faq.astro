---
import type { GetStaticPaths } from 'astro';
import FaqPage from '../../views/FaqPage.astro';
import { I18N_LOCALES, type Locale } from '../../i18n/locales';

export const getStaticPaths = (() => I18N_LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
---
<FaqPage locale={lang} />
