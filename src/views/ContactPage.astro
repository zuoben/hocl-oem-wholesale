---
import PageLayout from '../layouts/PageLayout.astro';
import FAQ from '../components/FAQ.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { localizePath, type Locale } from '../i18n/locales';
import { getContact } from '../i18n/pages';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getContact(locale);
---
<PageLayout title={c.title} description={c.description} locale={locale}>
  <section class="bg-gradient-to-b from-brand-50 to-white py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 text-center sm:px-6">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">{c.lead}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-x-8 gap-y-3 text-sm text-slate-700">
        {c.pills.map((pill) => (
          <span class="flex items-center gap-2"><span class="text-brand-600">●</span> {pill}</span>
        ))}
      </div>
      <a href="#inquiry-form" class="mt-8 inline-flex rounded-lg bg-brand-600 px-5 py-3 text-sm font-semibold text-white hover:bg-brand-700">
        {c.goForm}
      </a>
    </div>
  </section>
  <InquiryForm locale={locale} />
  <section class="py-12">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 sm:grid-cols-3 sm:px-6">
      {c.cards.map((card) => (
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h3 class="font-semibold text-slate-900">{card.t}</h3>
          <p class="mt-2 text-sm text-slate-600">{card.d}</p>
          {card.href && (
            <a href={localizePath(card.href, locale)} class="mt-3 inline-block text-sm font-semibold text-brand-700">
              {c.learnMore}
            </a>
          )}
        </div>
      ))}
    </div>
  </section>
  <FAQ title={c.faqTitle} items={c.faqItems} />
</PageLayout>
