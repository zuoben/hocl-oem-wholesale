---
import type { GetStaticPaths } from 'astro';
import LegalPage from '../../views/LegalPage.astro';
import { I18N_LOCALES, type Locale } from '../../i18n/locales';
import { getPrivacy } from '../../i18n/pages';

export const getStaticPaths = (() => I18N_LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
---
<LegalPage locale={lang} copy={getPrivacy(lang)} />
