---
import PageLayout from '../layouts/PageLayout.astro';
import type { Locale } from '../i18n/locales';
import type { LegalCopy } from '../i18n/types';

interface Props {
  locale: Locale;
  copy: LegalCopy;
}
const { locale, copy: c } = Astro.props;
---
<PageLayout title={c.title} description={c.description} locale={locale}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">{c.h1}</h1>
    <p class="mt-2 text-sm text-slate-500">{c.updated}</p>
    <div class="prose-sm mt-8 space-y-4 text-slate-700 leading-relaxed text-sm">
      {c.paragraphs.map((p) => (
        <p set:html={p} />
      ))}
      <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-950">
        <strong>{c.disclaimerTitle}</strong> {c.disclaimerBody}
      </div>
    </div>
  </article>
</PageLayout>
