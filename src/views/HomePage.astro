---
import PageLayout from '../layouts/PageLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import FAQ from '../components/FAQ.astro';
import InquiryForm from '../components/InquiryForm.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { localizePath, type Locale } from '../i18n/locales';
import { getHome, withLinks } from '../i18n/pages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getHome(locale);
const links = {
  oem: localizePath('/oem', locale),
  wholesale: localizePath('/wholesale', locale),
  rfq: `${localizePath('/contact', locale)}#inquiry-form`,
};
const faqItems = c.faqItems.map((item) => ({
  title: item.title,
  description: withLinks(item.description, links),
}));
---

<PageLayout title={c.title} description={c.description} locale={locale}>
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-50 via-white to-white">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-brand-100/80 via-transparent to-transparent"></div>
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:py-28">
      <div class="mx-auto max-w-3xl text-center">
        <p class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white/80 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-800 shadow-sm">
          {c.badge}
        </p>
        <h1 class="mt-6 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-[3.25rem] lg:leading-tight">
          {c.h1a}<br />
          <span class="text-brand-700">{c.h1b}</span>
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">{c.lead}</p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href={links.oem}
            class="inline-flex w-full items-center justify-center rounded-lg bg-brand-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700 sm:w-auto"
          >
            {c.ctaOem}
          </a>
          <a
            href={links.wholesale}
            class="inline-flex w-full items-center justify-center rounded-lg border border-slate-300 bg-white px-6 py-3.5 text-sm font-semibold text-slate-800 shadow-sm transition hover:bg-slate-50 sm:w-auto"
          >
            {c.ctaWholesale}
          </a>
        </div>
        <p class="mt-4 text-sm text-slate-500" set:html={withLinks(c.orRfq, links)} />
      </div>
    </div>
  </section>

  <TrustBar locale={locale} />

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-brand-700">{c.funnelKicker}</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">{c.funnelTitle}</h2>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        <a href={links.oem} class="group rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition hover:border-brand-300 hover:shadow-md">
          <span class="inline-flex rounded-lg bg-brand-100 px-2.5 py-1 text-xs font-semibold text-brand-800">{c.oemBadge}</span>
          <h3 class="mt-4 text-xl font-bold text-slate-900 group-hover:text-brand-800">{c.oemTitle}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{c.oemBody}</p>
          <span class="mt-6 inline-flex text-sm font-semibold text-brand-700">{c.oemLink}</span>
        </a>
        <a href={links.wholesale} class="group rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition hover:border-brand-300 hover:shadow-md">
          <span class="inline-flex rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700">{c.wholesaleBadge}</span>
          <h3 class="mt-4 text-xl font-bold text-slate-900 group-hover:text-brand-800">{c.wholesaleTitle}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{c.wholesaleBody}</p>
          <span class="mt-6 inline-flex text-sm font-semibold text-brand-700">{c.wholesaleLink}</span>
        </a>
      </div>
    </div>
  </section>

  <ProductGrid locale={locale} title={c.productsTitle} tagline={c.productsTagline} />

  <section class="bg-white pb-4 sm:pb-8">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="rounded-2xl border border-brand-200 bg-gradient-to-br from-brand-600 to-brand-800 p-8 text-white shadow-lg sm:p-10">
        <div class="grid gap-8 lg:grid-cols-2 lg:items-center">
          <div>
            <p class="text-sm font-medium text-brand-100">{c.inquiryKicker}</p>
            <ul class="mt-4 space-y-3 text-sm leading-relaxed">
              {c.inquiryItems.map((item) => (
                <li>✓ {item}</li>
              ))}
            </ul>
          </div>
          <div class="lg:text-right">
            <p class="text-sm text-brand-100 leading-relaxed">{c.inquiryNote}</p>
            <a href={links.rfq} class="mt-6 inline-flex rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-brand-800 hover:bg-brand-50">
              {c.inquiryCta}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FAQ title={c.faqTitle} items={faqItems} />
  <InquiryForm locale={locale} title={c.formTitle} />
</PageLayout>
