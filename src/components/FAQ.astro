---
interface Item {
  title: string;
  description: string;
}

interface Props {
  tagline?: string;
  title: string;
  items: Item[];
}

const { tagline = 'FAQ', title, items } = Astro.props;
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <p class="text-center text-sm font-semibold uppercase tracking-wide text-brand-700">{tagline}</p>
    <h2 class="mt-2 text-center text-3xl font-bold tracking-tight text-slate-900">{title}</h2>
    <div class="mt-10 divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
      {items.map((item) => (
        <details class="group px-5 py-4 open:bg-slate-50/80">
          <summary class="cursor-pointer list-none font-semibold text-slate-900 marker:content-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-3">
              {item.title}
              <span class="text-brand-600 transition group-open:rotate-45">+</span>
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600" set:html={item.description} />
        </details>
      ))}
    </div>
  </div>
</section>
